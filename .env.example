# Add these in Vercel → Project → Settings → Environment Variables (Production, Preview, Development),
# and copy to .env.local for `vercel dev`.

SUPABASE_URL=https://tudpjxabxxaubvthktqg.supabase.co
# Publishable key (sb_publishable_…). Safe for the browser. Never put the sb_secret_ key in this variable.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
SITE_URL=https://jyotish-mu.vercel.app

# Any long random string. Signs the free-trial cookie.
FREE_TRIAL_SECRET=change-me-to-a-long-random-string

# Optional but recommended: lets /api/signup create accounts that are confirmed instantly (no email).
# Use a NEW secret key (Supabase → Project Settings → API Keys → Secret keys). Add it ONLY in Vercel's
# Environment Variables. It is used only inside the server functions and is never sent to the browser.
# Never commit it, never paste it in chat, and never use it as SUPABASE_PUBLISHABLE_KEY.
SUPABASE_SECRET_KEY=

# Optional: daily e-mail / WhatsApp reminders (api/cron-reminders.js, run by Vercel Cron every evening).
# The calendar subscription link works without any of these.
CRON_SECRET=any-long-random-string
RESEND_API_KEY=
EMAIL_FROM=Kundali Ganit <reminders@your-domain.com>
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
