{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "trailingSlash": true,
  "functions": {
    "api/*.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{src/layout.html,src/sprite.svg,locales/*.json,.build-id}"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron-reminders/",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/cron-morning/",
      "schedule": "30 0 * * *"
    }
  ],
