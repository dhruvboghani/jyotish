{
  "appId": "com.grahavani.app",
  "appName": "Grahavani",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "backgroundColor": "#FFFFFF",
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 400,
      "launchAutoHide": true,
      "backgroundColor": "#16173B",
      "showSpinner": false,
      "androidScaleType": "CENTER_INSIDE"
    },
    "SystemBars": {
      "insetsHandling": "css",
      "style": "LIGHT"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_grahavani",
      "iconColor": "#D3971C"
    }
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#FFFFFF"
  }
}
