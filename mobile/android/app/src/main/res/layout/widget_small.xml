<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ws_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:padding="12dp" android:background="@drawable/widget_bg">
    <TextView android:id="@+id/ws_tithi" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Grahavani" android:textColor="#16173B" android:textSize="15sp" android:textStyle="bold"
        android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/ws_hora" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textColor="#8C5E05" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
